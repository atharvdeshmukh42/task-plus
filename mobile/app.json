{
  "expo": {
    "name": "Task Plus",
    "slug": "task-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskplus.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2953BC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.taskplus.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "scheme": "taskplus",
    "extra": {
      "eas": {
        "projectId": "6ffa8a83-16c9-4f32-bace-36b9f1606931"
      }
    },
    "owner": "atharvdeshmukh-thegeniusdev"
  }
}
