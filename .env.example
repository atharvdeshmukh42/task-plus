# Used by docker-compose.yml (deployment). Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
WEB_PORT=80
# Only needed if a browser app on another origin calls the API directly (e.g. Expo web).
CORS_ORIGINS=
